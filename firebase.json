{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "**/*.test.js"]
    }
  ],
  "emulators": {
    "firestore": { "port": 8085 },
    "database": { "port": 9010 },
    "storage": { "port": 9199 },
    "singleProjectMode": true
  }
}
